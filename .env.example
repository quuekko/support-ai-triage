# Provide at least one LLM key. The key stays on the server.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Or use Anthropic instead of OpenAI:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Required on Vercel for durable storage. Run schema.sql in Supabase first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required for login. Use distinct, strong passwords and a random secret (32+ characters).
AUTH_SECRET=
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
USER_LOGIN=user
USER_NAME=
USER_PASSWORD=

